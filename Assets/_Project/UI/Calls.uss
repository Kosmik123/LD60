.call-indicator {
    position: absolute;
    align-items: center;
    translate: -50% -100%;
}

.call-indicator__dot {
    width: 16px;
    height: 16px;
    border-radius: 8px;
    border-width: 2px;
    border-color: rgb(60, 40, 0);
    background-color: rgb(255, 200, 50);
}

.call-indicator__message {
    margin-bottom: 4px;
    padding: 2px 8px;
    border-radius: 4px;
    background-color: rgba(190, 40, 30, 0.92);
    color: rgb(255, 255, 255);
    font-size: 14px;
    -unity-font-style: bold;
}
