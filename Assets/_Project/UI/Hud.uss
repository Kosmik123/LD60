.hud-top {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    padding: 16px;
}

.hud-panel {
    min-width: 180px;
    padding: 8px 14px;
    border-radius: 8px;
    background-color: rgba(20, 20, 24, 0.85);
}

.hud-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.hud-caption {
    margin-right: 16px;
    color: rgb(170, 170, 180);
    font-size: 12px;
    -unity-font-style: bold;
}

.hud-value {
    color: rgb(240, 240, 240);
    font-size: 20px;
    -unity-font-style: bold;
}

.hud-meter {
    height: 6px;
    margin: 2px 0 4px 0;
    border-radius: 3px;
    background-color: rgb(52, 52, 60);
    overflow: hidden;
}

.hud-meter__fill {
    height: 100%;
    background-color: rgb(110, 200, 120);
}

.hud-meter--low .hud-meter__fill {
    background-color: rgb(230, 90, 70);
}

/* Okienko nad słupem: left/top ustawia kod, translate centruje je nad punktem. */
.node-tooltip {
    position: absolute;
    translate: -50% -100%;
    align-items: center;
    padding: 4px 10px;
    border-radius: 6px;
    background-color: rgba(20, 20, 24, 0.85);
}

.node-tooltip__caption {
    color: rgb(170, 170, 180);
    font-size: 10px;
    -unity-font-style: bold;
}

.node-tooltip__value {
    color: rgb(240, 240, 240);
    font-size: 18px;
    -unity-font-style: bold;
}

.node-tooltip--full .node-tooltip__value {
    color: rgb(255, 110, 90);
}

/* Cena nad podglądem kabla. */
.price-tag {
    position: absolute;
    translate: -50% -100%;
    padding: 2px 8px;
    border-radius: 5px;
    background-color: rgba(20, 20, 24, 0.85);
    color: rgb(255, 220, 120);
    font-size: 16px;
    -unity-font-style: bold;
}

.price-tag--unaffordable {
    color: rgb(255, 110, 90);
}
